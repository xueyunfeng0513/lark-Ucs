# 企业自建应用：开发者后台 -> 凭证与基础信息
APP_ID=replace_app_id
APP_SECRET=replace_app_secret
# 以下两项仅 webhook 模式必需；websocket 模式可留空。
# 开发者后台 -> 事件与回调 -> 加密策略
VERIFICATION_TOKEN=replace_verification_token
ENCRYPT_KEY=replace_encrypt_key
# 可选：允许发送文件的用户 open_id，多个以逗号分隔。
# 留空表示允许机器人可用范围内的所有单聊用户。
ALLOWED_OPEN_IDS=
PORT=3000
JOB_DB=.runtime/jobs.sqlite3
# 可选 webhook / websocket。python -m excel_counter 默认 webhook；
# bootstrap.sh 默认 websocket；命令行 --transport 优先。
# TRANSPORT=webhook
